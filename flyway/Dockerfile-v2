# Use Flyway base image
FROM flyway/flyway:7.15.0-alpine

# Set environment variables for database connection
ENV FLYWAY_URL=jdbc:postgresql://your_db_host:your_db_port/your_db_name
ENV FLYWAY_USER=your_db_user
ENV FLYWAY_PASSWORD=your_db_password

# Set optional environment variables for Flyway migration
ENV FLYWAY_SCHEMAS=public
# Add more environment variables as needed

# Copy SQL migration scripts into the container
COPY sql_migrations /flyway/sql/

# Run Flyway migration on container startup
CMD ["migrate"]
